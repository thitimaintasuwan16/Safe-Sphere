        riskLevel: 'medium',
        bufferDays: 18,
        contactPerson: 'คุณธนกฤต',
        phone: '086-778-9900',
        route: 'เส้นทาง สาย 344 มีฝนตกชุก รถบรรทุกผ่านได้ปกติ',
        statusDesc: 'มีฝนตกหนักสะสม เฝ้าระวังน้ำขังขอบทางขนส่ง',
