    // Initialize System on Load
    window.onload = function() {
      renderSuppliersGrid('all');
      calculateAnnualFeeAndROI();
    };

    // 1. Navigation Tab Switcher
    function switchTab(tabId) {
      currentTab = tabId;
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      
      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.remove('bg-cyan-600', 'text-white', 'shadow-lg', 'shadow-cyan-600/30');
        btn.classList.add('text-slate-400', 'hover:text-white', 'hover:bg-slate-800');
      });

      const targetSec = document.getElementById('sec-' + tabId);
      if (targetSec) targetSec.classList.remove('hidden');

      const targetBtn = document.getElementById('tab-btn-' + tabId);
      if (targetBtn) {
        targetBtn.classList.remove('text-slate-400', 'hover:text-white', 'hover:bg-slate-800');
        targetBtn.classList.add('bg-cyan-600', 'text-white', 'shadow-lg', 'shadow-cyan-600/30');
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 2. Multi-Facility Switcher
    function changeFacility(val) {
      const headerTitle = document.getElementById('headerFactoryName');
      if (val === 'f1') headerTitle.innerText = 'อมตะซิตี้ #4';
      else if (val === 'f2') headerTitle.innerText = 'บางปะอิน (อยุธยา)';
      else if (val === 'f3') headerTitle.innerText = 'ศูนย์บางนา กม.19';
    }

    // 3. Automated Notifications & Voice Calls
    function toggleAutoNotification() {
      isAutoNotifyActive = !isAutoNotifyActive;
      const dot = document.getElementById('autoNotifyDot');
      const btn = document.getElementById('toggleAutoNotifyBtn');
      const text = document.getElementById('autoNotifyStatusText');

      if (isAutoNotifyActive) {
        dot.classList.remove('translate-x-0');
        dot.classList.add('translate-x-5');
        btn.classList.remove('bg-slate-700');
        btn.classList.add('bg-emerald-500');
        text.innerText = 'เปิดอยู่';
        text.classList.remove('text-slate-400');
        text.classList.add('text-emerald-400');
      } else {
        dot.classList.remove('translate-x-5');
        dot.classList.add('translate-x-0');
        btn.classList.remove('bg-emerald-500');
        btn.classList.add('bg-slate-700');
        text.innerText = 'ปิดอยู่';
        text.classList.remove('text-emerald-400');
        text.classList.add('text-slate-400');
      }
    }

    function openNotificationModal() {
      document.getElementById('modalNotification').classList.remove('hidden');
    }
    function closeNotificationModal() {
      document.getElementById('modalNotification').classList.add('hidden');
    }

    function triggerTestNotification() {
      const level = document.getElementById('testAlertLevel').value;
      closeNotificationModal();

      const logList = document.getElementById('notificationLogList');
      const timeStr = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }) + ' น.';

      const newLog = document.createElement('div');
      newLog.className = "p-3 bg-slate-950 rounded-xl border border-slate-800/80 text-xs space-y-1 animate-pulse";

      if (level === 'critical') {
        newLog.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="font-bold text-rose-400"><i class="fa-solid fa-phone-volume mr-1"></i> ระดับวิกฤต (CEO Voice Call Output)</span>
            <span class="text-[10px] text-slate-500">${timeStr}</span>
          </div>
          <p class="text-slate-300">ระบบทำการโทรออกอัตโนมัติถึง CEO และส่ง SMS เตือนภัยรวมถึง LINE Notify สำเร็จแล้ว</p>
        `;
      } else {
        newLog.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="font-bold text-amber-400"><i class="fa-solid fa-bell mr-1"></i> ระดับเฝ้าระวัง (Watch Test)</span>
            <span class="text-[10px] text-slate-500">${timeStr}</span>
          </div>
          <p class="text-slate-300">ส่งการแจ้งเตือนผ่าน Email และ App Push Notification เรียบร้อยแล้ว</p>
        `;
      }

      logList.prepend(newLog);
    }

    // 4. SUPPLIER MANAGEMENT LOGIC
    function renderSuppliersGrid(filter) {
      const container = document.getElementById('suppliersGrid');
      container.innerHTML = '';

      let filtered = suppliersData;
      if (filter !== 'all') {
        filtered = suppliersData.filter(s => s.riskLevel === filter);
      }

      document.getElementById('totalSupplierCountText').innerText = suppliersData.length + ' ราย';
      const highRiskCount = suppliersData.filter(s => s.riskLevel === 'high').length;
      document.getElementById('statSupplierRiskCount').innerText = highRiskCount + ' / ' + suppliersData.length + ' ราย';
      document.getElementById('highRiskSupplierCountText').innerText = highRiskCount + ' ราย';

      if (filtered.length === 0) {
        container.innerHTML = `<div class="col-span-3 text-center py-8 text-xs text-slate-500">ไม่พบข้อมูลซัพพลายเออร์ในหมวดหมู่นี้</div>`;
        return;
      }

      filtered.forEach(sup => {
        let badgeClass = '';
        let badgeText = '';
        let borderClass = 'border-slate-800';

        if (sup.riskLevel === 'high') {
          badgeClass = 'bg-rose-500/20 text-rose-300 border-rose-500/40';
          badgeText = 'เสี่ยงสูงมาก';
          borderClass = 'border-rose-900/50';
        } else if (sup.riskLevel === 'medium') {
          badgeClass = 'bg-amber-500/20 text-amber-300 border-amber-500/40';
          badgeText = 'เฝ้าระวัง';
          borderClass = 'border-amber-900/50';
        } else {
          badgeClass = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40';
          badgeText = 'ปกติ / ปลอดภัย';
          borderClass = 'border-slate-800';
        }

        const card = document.createElement('div');
        card.className = `bg-slate-950 border ${borderClass} rounded-2xl p-4 flex flex-col justify-between space-y-3 hover:border-slate-700 transition shadow-lg`;
        card.innerHTML = `
          <div>
            <div class="flex justify-between items-start">
              <div>
                <h4 class="font-bold text-white text-sm">${sup.name}</h4>
                <p class="text-[11px] text-teal-400 mt-0.5"><i class="fa-solid fa-box mr-1"></i>${sup.material}</p>
                <p class="text-[11px] text-slate-400"><i class="fa-solid fa-location-dot mr-1 text-rose-400"></i>${sup.location}</p>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${badgeClass}">${badgeText}</span>
            </div>

            <div class="mt-3 p-2.5 bg-slate-900/80 rounded-xl border border-slate-800 text-xs space-y-1.5">
              <p class="text-slate-300"><strong class="text-slate-400">สถานะ:</strong> ${sup.statusDesc}</p>
              <p class="text-slate-400 text-[11px]"><strong class="text-slate-300">เส้นทาง:</strong> ${sup.route}</p>
              ${sup.notes ? `<p class="text-amber-300/90 text-[11px] italic"><i class="fa-solid fa-note-sticky mr-1"></i>${sup.notes}</p>` : ''}
            </div>
          </div>

          <div class="pt-2 border-t border-slate-900 flex items-center justify-between text-xs">
            <div>
              <span class="text-[10px] text-slate-500 block">สต็อกสำรอง (Buffer)</span>
              <span class="font-bold text-amber-400">${sup.bufferDays} วัน</span>
            </div>
            <div class="space-x-1">
              <button onclick="openEditSupplierModal('${sup.id}')" class="bg-slate-800 hover:bg-slate-700 text-cyan-300 px-2.5 py-1 rounded-lg text-[11px] border border-slate-700">
                <i class="fa-solid fa-pen-to-square mr-1"></i>แก้ไข
              </button>
              <button onclick="deleteSupplier('${sup.id}')" class="bg-slate-800 hover:bg-rose-900/50 text-rose-300 px-2.5 py-1 rounded-lg text-[11px] border border-slate-700">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function filterSuppliers(type) {
      renderSuppliersGrid(type);
    }

    function openAddSupplierModal() {
      document.getElementById('supplierEditId').value = '';
      document.getElementById('supName').value = '';
      document.getElementById('supMaterial').value = '';
      document.getElementById('supLocation').value = '';
      document.getElementById('supRiskLevel').value = 'high';
      document.getElementById('supBufferDays').value = '14';
      document.getElementById('supContactPerson').value = '';
      document.getElementById('supPhone').value = '';
      document.getElementById('supRoute').value = '';
      document.getElementById('supNotes').value = '';
      document.getElementById('modalSupplier').classList.remove('hidden');
    }

    function openEditSupplierModal(id) {
      const sup = suppliersData.find(s => s.id === id);
      if (!sup) return;

      document.getElementById('supplierEditId').value = sup.id;
      document.getElementById('supName').value = sup.name;
      document.getElementById('supMaterial').value = sup.material;
      document.getElementById('supLocation').value = sup.location;
      document.getElementById('supRiskLevel').value = sup.riskLevel;
      document.getElementById('supBufferDays').value = sup.bufferDays;
      document.getElementById('supContactPerson').value = sup.contactPerson || '';
      document.getElementById('supPhone').value = sup.phone || '';
      document.getElementById('supRoute').value = sup.route || '';
      document.getElementById('supNotes').value = sup.notes || '';
      document.getElementById('modalSupplier').classList.remove('hidden');
    }

    function closeSupplierModal() {
      document.getElementById('modalSupplier').classList.add('hidden');
    }

    function saveSupplierDetails(e) {
      e.preventDefault();
      const editId = document.getElementById('supplierEditId').value;
      const name = document.getElementById('supName').value;
      const material = document.getElementById('supMaterial').value;
      const location = document.getElementById('supLocation').value;
      const riskLevel = document.getElementById('supRiskLevel').value;
      const bufferDays = parseInt(document.getElementById('supBufferDays').value) || 7;
      const contactPerson = document.getElementById('supContactPerson').value;
      const phone = document.getElementById('supPhone').value;
      const route = document.getElementById('supRoute').value;
      const notes = document.getElementById('supNotes').value;

      let statusDesc = 'ติดตามเฝ้าระวังสถานการณ์น้ำปกติ';
      if (riskLevel === 'high') statusDesc = 'อยู่ในพื้นที่เสี่ยงน้ำท่วมสูง การส่งมอบอาจหยุดชะงัก';
      else if (riskLevel === 'medium') statusDesc = 'เฝ้าระวังเส้นทางขนส่ง อาจมีฝนตกชุกชะลอการส่งมอบ';

      if (editId) {
        const idx = suppliersData.findIndex(s => s.id === editId);
        if (idx !== -1) {
          suppliersData[idx] = {
            id: editId, name, material, location, riskLevel, bufferDays, contactPerson, phone, route, statusDesc, notes
          };
        }
      } else {
        const newSup = {
          id: 'sup-' + Date.now(),
          name, material, location, riskLevel, bufferDays, contactPerson, phone, route, statusDesc, notes
        };
        suppliersData.unshift(newSup);
      }

      closeSupplierModal();
      renderSuppliersGrid('all');
    }

    function deleteSupplier(id) {
      if (confirm('คุณต้องการลบซัพพลายเออร์รายการนี้ใช่หรือไม่?')) {
        suppliersData = suppliersData.filter(s => s.id !== id);
        renderSuppliersGrid('all');
      }
    }

    // 5. WHAT-IF SIMULATOR
    function updateWhatIfSimulation() {
      const level = parseInt(document.getElementById('waterLevelInput').value);
      const days = parseInt(document.getElementById('durationInput').value);

      document.getElementById('waterLevelVal').innerText = '+' + level + ' ซม.';
      document.getElementById('durationVal').innerText = days + ' วัน';

      const rawMatLoss = level * 100000 * (days * 0.5);
      const machineryLoss = level > 50 ? (level - 50) * 400000 : 0;
      const downtimeLoss = days * 4000000;
      const totalLoss = rawMatLoss + machineryLoss + downtimeLoss;

      document.getElementById('simRawMatLoss').innerText = '฿ ' + rawMatLoss.toLocaleString();
      document.getElementById('simMachineryLoss').innerText = '฿ ' + machineryLoss.toLocaleString();
      document.getElementById('simDowntimeLoss').innerText = '฿ ' + downtimeLoss.toLocaleString();
      document.getElementById('simTotalLoss').innerText = '฿ ' + totalLoss.toLocaleString();

      const overlay = document.getElementById('simWaterOverlay');
      const heightPct = Math.min(100, Math.max(5, (level / 150) * 100));
      overlay.style.height = heightPct + '%';
      document.getElementById('simWaterLabelOnGraphic').innerText = 'ระดับน้ำ +' + level + ' cm';
    }

    function applySimToRescue() {
      switchTab('rescue');
    }

    // 6. RESCUE PRIORITY
    function openAddAssetModal() {
      document.getElementById('modalAddAsset').classList.remove('hidden');
    }
    function closeAddAssetModal() {
      document.getElementById('modalAddAsset').classList.add('hidden');
    }
    function saveNewAsset(e) {
      e.preventDefault();
      const name = document.getElementById('newAssetName').value;
      const val = parseInt(document.getElementById('newAssetValue').value) || 0;
      const time = document.getElementById('newAssetTime').value;
      const priority = document.getElementById('newAssetPriority').value;

      let prioText = '<span class="font-bold text-amber-400">ความสำคัญสูง</span>';
      if (priority === '1') prioText = '<span class="font-bold text-rose-400">วิกฤตด่วนที่สุด</span>';
      else if (priority === '3') prioText = '<span class="font-bold text-teal-400">ปานกลาง</span>';

      const table = document.getElementById('assetTableBody');
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-slate-800/40';
      tr.innerHTML = `
        <td class="p-3.5">${prioText}</td>
        <td class="p-3.5 font-semibold text-white">${name}</td>
        <td class="p-3.5">อาคารผลิตหลัก</td>
        <td class="p-3.5 font-mono text-white">฿ ${val.toLocaleString()}</td>
        <td class="p-3.5">${time} นาที</td>
        <td class="p-3.5">ทีมฉุกเฉินประจำวัน</td>
        <td class="p-3.5 text-center"><span class="px-2 py-1 rounded bg-slate-800 text-slate-400 text-[10px]">รอเริ่ม</span></td>
        <td class="p-3.5 text-right space-x-2">
          <button onclick="toggleAssetStatus(this)" class="bg-emerald-600/30 hover:bg-emerald-600/50 text-emerald-300 px-2.5 py-1 rounded text-[10px]">ทำเสร็จแล้ว</button>
        </td>
      `;
      table.prepend(tr);
      closeAddAssetModal();
    }

    function toggleAssetStatus(btn) {
      const td = btn.parentElement.previousElementSibling;
      td.innerHTML = '<span class="px-2 py-1 rounded bg-emerald-500/20 text-emerald-300 text-[10px] font-bold">ขนย้ายเรียบร้อย</span>';
      btn.disabled = true;
      btn.className = 'opacity-50 text-slate-500 text-[10px]';
    }

    // 7. ROI CALCULATOR LOGIC (WITH NEW PRICING)
    function calculateAnnualFeeAndROI() {
      const assetVal = parseInt(document.getElementById('calcAssetInput').value);
      const factoryCount = parseInt(document.getElementById('calcFactoryCountInput').value);
      const planFee = parseInt(document.getElementById('calcPlanSelect').value);

      document.getElementById('calcAssetValLabel').innerText = '฿ ' + assetVal.toLocaleString();
      document.getElementById('calcFactoryCountLabel').innerText = factoryCount + ' แห่ง';

      let totalAnnualFee = planFee * factoryCount;
      if (planFee === 180000) totalAnnualFee = 180000; // Flat Enterprise Rate

      const protectedVal = Math.round(assetVal * 0.80);
      const roiFactor = totalAnnualFee > 0 ? Math.round(protectedVal / totalAnnualFee) : 'Infinite';

      document.getElementById('resAnnualFee').innerText = totalAnnualFee === 0 ? 'ไม่มีค่าบริการ (ฟรี)' : '฿ ' + totalAnnualFee.toLocaleString() + ' / ปี';
      document.getElementById('resProtectedValue').innerText = '฿ ' + protectedVal.toLocaleString();
      document.getElementById('resRoiFactor').innerText = totalAnnualFee === 0 ? 'ใช้งานฟรี' : roiFactor + 'x คุ้มค่า';
    }

    function selectPlan(planKey, fee) {
      switchTab('pricing');
      document.getElementById('calcPlanSelect').value = fee.toString();
      calculateAnnualFeeAndROI();
    }

    // Modal Factory Info
    function openFactoryModal() { document.getElementById('modalFactory').classList.remove('hidden'); }
    function closeFactoryModal() { document.getElementById('modalFactory').classList.add('hidden'); }
    function saveFactorySettings(e) {
      e.preventDefault();
      document.getElementById('headerFactoryName').innerText = document.getElementById('inputFactoryName').value;
      closeFactoryModal();
    }

    // Map Filters
    function filterMapPoints(cat) {
      const points = document.querySelectorAll('.map-point');
      points.forEach(p => {
        if (cat === 'all' || p.classList.contains(cat)) {
          p.classList.remove('hidden');
        } else {
          p.classList.add('hidden');
        }
      });
    }

    // Export Placeholders
    function exportLedgerCSV() { alert('ระบบสร้างไฟล์ CSV บัญชีเคลมความเสียหายเรียบร้อยแล้ว'); }
    function exportLedgerPDF() { alert('กำลังสร้างรายงานสรุปเอกสารเคลมประกันภัย PDF'); }
    function downloadResilienceReport() { alert('กำลังดาวน์โหลดใบรับรอง Resilience Scorecard Certificate (PDF)'); }
  </script>
